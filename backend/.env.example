# =====================================================================
# Copy this file to `.env` for local development.
# On Render, set these under your Web Service -> Environment tab.
# NEVER commit a real .env file to GitHub.
# =====================================================================

# Telegram Bot (from @BotFather)
BOT_TOKEN=

# Public HTTPS URL of this backend once deployed on Render
# e.g. https://your-backend-name.onrender.com
BACKEND_PUBLIC_URL=

# Public HTTPS URL of the deployed Mini App (frontend)
# e.g. https://your-mini-app-name.onrender.com
TELEGRAM_WEBAPP_URL=

# Supabase project settings (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Port (Render sets this automatically — safe to leave blank locally, defaults to 3000)
PORT=3000

# Comma-separated list of allowed CORS origins for the API
# (should include your Mini App's Render URL)
ALLOWED_ORIGINS=http://localhost:5173
